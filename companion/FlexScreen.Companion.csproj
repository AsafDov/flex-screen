<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows SDK target brings the WinRT media-session API (Windows.Media.Control). -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>flex-screen-companion</AssemblyName>
    <RootNamespace>FlexScreen.Companion</RootNamespace>
    <!-- Window positions and zones in physical pixels on every monitor, whatever its scale. -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- install\build-dist.ps1 sets the release's version (-p:Version=0.21.0); the update
         check (SelfUpdate.cs) compares it with GitHub's newest release. A build from the
         repo is a development build and doesn't look for updates. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- UI Automation (System.Windows.Automation) reads the taskbar's order. UseWPF would bring
         it too, but also drops System.IO and System.Net.Http from the implicit usings. -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App.WPF" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.IO.Ports" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The sites the browser's bar has keys for, as data (WebSites.cs); a profile's "sites" add to them. -->
    <EmbeddedResource Include="Integrations\Browser\sites.json" LogicalName="sites.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- A test harness built beside the companion may use its classes (all internal). -->
    <InternalsVisibleTo Include="FlexScreen.Tests" />
  </ItemGroup>

</Project>
